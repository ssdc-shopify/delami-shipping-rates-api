#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# Public URL of this app. Shopify's OAuth redirect, the webhooks and the
# CarrierService callback are all built from it.
app.baseURL = 'http://localhost:8080/'
app.indexPage = ''

# ⚠️  DEVELOPMENT ONLY — DELETE BOTH LINES ON THE PRODUCTION SERVER ⚠️
#
# Both default to TRUE in app/Config/App.php and app/Config/Cookie.php.
# These two lines exist only so the app can be served over plain HTTP
# locally; .env is an override DOWNWARDS, never an upgrade.
#
# Left in place on the server they silently:
#   - stop redirecting HTTP to HTTPS and drop the HSTS header, and
#   - send the admin session cookie without the Secure flag,
# so an admin login — carrying Shopify access tokens and customer
# addresses — can travel in clear text. Nothing warns you.
app.forceGlobalSecureRequests = false
cookie.secure = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
# sqlite (default) or mysql. For mysql, also set database.default.hostname,
# .port, .database, .username and .password.
DB_CONNECTION = sqlite

# SQLite file, relative to writable/database/ unless it contains a slash.
DB_DATABASE = delami.sqlite

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------
# Encrypts Shopify access tokens and app secrets at rest. Generate one with
# `php spark key:generate`. Never change it on an install that already has
# connected stores — every stored token becomes unreadable.
encryption.key =

#--------------------------------------------------------------------
# SHOPIFY
#--------------------------------------------------------------------
# Per-store app credentials (Client ID/Secret) and access tokens are
# entered in Admin → Stores and stored encrypted in the DB — not here.

# Shared secret appended to the CarrierService callback URL (?token=...).
# App-generated (NOT a Shopify credential) — protects the rate endpoint.
shopify.carrierCallbackToken =

#--------------------------------------------------------------------
# COURIERS — RATES (required for checkout quotes)
#--------------------------------------------------------------------
# Every JNE / Ninja / SPX price comes through the Delami widget proxy; no
# courier API key is needed to quote.
couriers.proxyBaseUrl = 'https://widget.delamibrands.com/colorbox/shipping/Api'

# Google Geocoding API key. Turns a checkout address into coordinates so
# GrabExpress can be quoted in native Shopify checkout; blank disables that.
# Restrict it to the Geocoding API and the server's IP in Google Cloud.
couriers.geocodeApiKey =

#--------------------------------------------------------------------
# COURIERS — AWB BOOKING & TRACKING
#--------------------------------------------------------------------
# Used only by Generate AWB and order tracking. Mock mode (Admin →
# Settings) never calls them.

# JNE — generatecnote + tracing
couriers.jneBaseUrl = 'https://apiv2.jne.co.id:10206'
couriers.jneTraceUrl = 'http://apiv2.jne.co.id:10101'
couriers.jneUsername =
couriers.jneApiKey =
couriers.jneCodAccount =
couriers.jneRegAccount =

# SPX / Shopee Express — HMAC-signed
couriers.spxBaseUrl = 'https://spx.co.id'
couriers.spxAppId =
couriers.spxAppSecret =
couriers.spxUserId =
couriers.spxUserSecret =

# Ninja Xpress — its OAuth token comes from the widget proxy
couriers.ninjaBaseUrl = 'https://api.ninjavan.co/id'

# LJR / Lestari Jaya Raya — tracking only
couriers.ljrBaseUrl = 'https://lestarijayaraya.co.id:10433/api/v2/dlm_api'
couriers.ljrApiKey =

#--------------------------------------------------------------------
# HEADLESS STOREFRONTS
#--------------------------------------------------------------------
# Browser origins allowed to call /api/storefront/* (comma-separated).
# Scheme, host and port must match exactly. On production list the real
# storefront domains: a missing origin shows the cart no rates at all,
# reported only as an opaque "Failed to fetch". Browsers only — Expo sends
# no Origin header and is bounded by its publishable key instead.
cors.storefrontOrigins = 'http://localhost:5173,http://127.0.0.1:5173'
