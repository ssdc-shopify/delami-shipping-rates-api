# Shopify Storefront API (public token — safe for the browser, but keep the
# real value in .env.local which is gitignored). Used for products, the cart,
# and the checkout handoff — NOT for shipping rates.
VITE_SHOPIFY_DOMAIN=your-store.myshopify.com
VITE_STOREFRONT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_API_VERSION=2026-07

# The CI4 app's cart-rate endpoint. This is what prices the cart page:
# Shopify only calls a CarrierService inside checkout, and the Storefront API
# cannot reach one, so the cart asks the app directly.
VITE_RATES_API_URL=https://your-app.ngrok-free.dev/api/storefront/rates

# Publishable per-store key. Issue it in the CI4 admin:
# Stores -> Edit settings -> Generate key. Safe in a browser bundle; it
# identifies and throttles the caller rather than protecting a secret.
# This page's origin must also appear in cors.storefrontOrigins in the CI4 .env.
VITE_STOREFRONT_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Only rates whose service_code starts with this prefix are offered.
VITE_RATE_CODE_PREFIX=BDD-
