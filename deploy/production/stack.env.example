# Store the completed file in GitLab as the PRODUCTION_ENV_FILE file variable.
# Never commit production credentials to this repository.

CI_ENVIRONMENT=production
app.baseURL=https://rates.delamibrands.com/
app.indexPage=
app.forceGlobalSecureRequests=true
cookie.secure=true

# SQLite is the default and is persisted in the Compose writable volume.
DB_CONNECTION=sqlite
DB_DATABASE=delami.sqlite
database.sqlite.DBDebug=false

# Generate with: php spark key:generate
encryption.key=replace-with-a-production-encryption-key

# Generate an independent random value, for example: openssl rand -hex 32
shopify.carrierCallbackToken=replace-with-a-random-carrier-callback-token

# Browser origins allowed to call /api/storefront/*, comma-separated. Leave
# empty when no separate browser storefront calls these endpoints.
cors.storefrontOrigins=

# Required for JNE, Ninja, and SPX checkout quotes.
couriers.proxyBaseUrl=https://widget.delamibrands.com/colorbox/shipping/Api

# Copy the remaining production courier values from .env.example. Blank or
# omitted credentials leave their corresponding optional integrations
# unavailable without weakening the application-level authentication above.
